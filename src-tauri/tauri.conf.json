{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.2.0",
  "identifier": "com.evilander.relay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Relay","width":1320,"height":860,"minWidth":800,"minHeight":550,"backgroundColor":"#111418"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active":true,"targets":"all",
    "icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "shortDescription":"Terminal and connection workspace","category":"DeveloperTool",
    "publisher":"Tyler Eveland","homepage":"https://github.com/Evilander/relay-terminal",
    "license":"MIT","licenseFile":"../LICENSE","copyright":"Copyright 2026 Tyler Eveland",
    "resources":{"../LICENSE":"LICENSE.txt","../THIRD_PARTY_NOTICES.txt":"THIRD_PARTY_NOTICES.txt"}
  }
}
